{
  "command": "node",
  "args": ["main.mjs"],
  "env": {
    "NODE_USE_ENV_PROXY": "1",
    "PREDICTOR_REV": "7"
  },
  "restart_policy": "always",
  "display_name": "Prompt Predictor",
  "description": "Predicts likely next user prompts after each agent turn, with ghost-text Tab accept and one-click send.",
  "has_web_ui": true,
  "ui_config": {
    "display_name": "Prompt Predictor",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "Prompt Predictor"
      }
    ]
  }
}
